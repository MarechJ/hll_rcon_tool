{
  "name": "vite-react-tailwind-starter",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "prepare": "husky install",
    "copy-assets": "mkdir -p public && cp -r ../assets/rcongui/* public/ && cp -r ../assets/images/* public/",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite build && vite preview --mode development --port 3000",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint": "eslint --quiet src -c eslintrc.mjs && stylelint src/**/*.less",
    "lint:fix": "eslint --quiet --fix src -c eslintrc.mjs && stylelint --fix src/**/*.less",
    "i18next-resources-for-ts": "i18next-resources-for-ts toc -i ./src/i18n/locales/en -o ./src/types/resources.ts",
    "translate": "transmart"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^3.9.1",
    "@shadcn/react": "^0.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.62.3",
    "@tanstack/react-table": "^8.20.5",
    "@transmart/cli": "^0.5.1",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "country-list": "^2.3.0",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.13",
    "embla-carousel-react": "^8.5.1",
    "i18next": "^24.0.5",
    "i18next-browser-languagedetector": "^8.0.1",
    "i18next-resources-to-backend": "^1.2.1",
    "input-otp": "^1.4.1",
    "lucide-react": "^0.468.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^4.1.2",
    "react-helmet": "^6.1.0",
    "react-hook-form": "^7.54.0",
    "react-i18next": "^15.1.3",
    "react-resizable-panels": "^4.12.2",
    "react-router": "^7.18.2",
    "recharts": "^3.8.0",
    "simple-icons": "^13.19.0",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.5.5",
    "vaul": "^1.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/compat": "^1.2.4",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.16.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.62.3",
    "@types/loadable__component": "^5.13.9",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-helmet": "^6.1.11",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^15.13.0",
    "husky": "^9.1.7",
    "i18next-resources-for-ts": "1.5.0",
    "less": "^4.2.1",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.13",
    "postcss-less": "^6.0.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^16.11.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-less": "^3.0.1",
    "stylelint-prettier": "5",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.2",
    "vite-plugin-external": "^4.3.1",
    "vite-plugin-svgr": "^4.3.0"
  }
}
